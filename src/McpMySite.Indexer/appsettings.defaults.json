{
  "Site": {
    "Url": ""
  },
  "Source": {
    "Type": "Crawl",
    "FolderUrlStyle": "Clean"
  },
  "Crawl": {
    "UseSitemap": true,
    "AlwaysFollowLinks": false,
    "RespectRobotsTxt": true,
    "MaxPages": 1000,
    "Include": [],
    "Exclude": [],
    "Concurrency": 4,
    "DelayMilliseconds": 0,
    "TimeoutSeconds": 30,
    "UserAgent": "McpMySiteIndexer/0.1 (+https://github.com/pournasserian/mcp-my-site)"
  },
  "Chunking": {
    "MaxChars": 1500,
    "MinChars": 200
  },
  "Embeddings": {
    "Endpoint": "https://openrouter.ai/api/v1",
    "Model": "openai/text-embedding-3-small",
    "Dimensions": 512,
    "ApiKeyEnvironmentVariable": "OPENROUTER_API_KEY",
    "BatchSize": 64
  },
  "Cache": {
    "Enabled": true,
    "Path": ".mcpmysite/embedding-cache.sqlite"
  },
  "Output": {
    "Directory": "index",
    "Store": "json"
  },
  "Safety": {
    "MinPages": 1,
    "MaxPageDropPercent": 50,
    "MaxErrorPercent": 20,
    "LowTextChars": 200
  },
  "Instructions": {},
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http": "Warning"
    }
  }
}
