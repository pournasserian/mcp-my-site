<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>McpMySite.Indexer</RootNamespace>
    <AssemblyName>mcpmysite</AssemblyName>
    <Description>Command-line indexer: crawls a website and builds a search index for the MCP my site server.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mcpmysite</ToolCommandName>
    <UserSecretsId>mcpmysite-indexer</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpMySite.Core\McpMySite.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="McpMySite.Tests" />
  </ItemGroup>

</Project>
