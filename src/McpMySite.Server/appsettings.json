{
  "Index": {
    "Path": "",
    "Url": "",
    "PollIntervalSeconds": 300
  },
  "Embeddings": {
    "Endpoint": "https://openrouter.ai/api/v1",
    "ApiKeyEnvironmentVariable": "AI_API_KEY"
  },
  "Mcp": {
    "Path": "/mcp",
    "ServerName": "mcp-my-site",
    "ApiKey": null,
    "Instructions": null,
    "AllowedOrigins": []
  },
  "SearchApi": {
    "Enabled": true,
    "Path": "/api/search",
    "AllowedOrigins": [],
    "DefaultLimit": 10,
    "MaxLimit": 20,
    "MaxQueryLength": 500
  },
  "Ui": {
    "Enabled": true,
    "PublicUrl": null,
    "StaleAfterDays": 30
  },
  "RateLimiting": {
    "PermitPerMinute": 60,
    "UseForwardedHeaders": true
  },
  "Telemetry": {
    "Exporter": "Auto",
    "LogQueryText": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    },
    "OpenTelemetry": {
      "LogLevel": {
        "Microsoft.AspNetCore.HttpLogging": "Warning",
        "ModelContextProtocol": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
