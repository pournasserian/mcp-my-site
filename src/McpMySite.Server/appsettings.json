{
  "Index": {
    "Path": "",
    "Url": "",
    "PollIntervalSeconds": 300
  },
  "Embeddings": {
    "Endpoint": "https://openrouter.ai/api/v1",
    "ApiKeyEnvironmentVariable": "OPENROUTER_API_KEY"
  },
  "Mcp": {
    "Path": "/mcp",
    "ServerName": "mcp-my-site",
    "ApiKey": null,
    "Instructions": null,
    "AllowedOrigins": []
  },
  "SearchApi": {
    "Enabled": true,
    "Path": "/api/search",
