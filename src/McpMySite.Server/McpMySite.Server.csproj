<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>McpMySite.Server</RootNamespace>
    <Description>Web app that serves a site index through an MCP server and a search API.</Description>
    <UserSecretsId>mcpmysite-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpMySite.Core\McpMySite.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="McpMySite.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="McpMySite.Server.Index" />
    <Using Include="McpMySite.Server.Options" />
    <Using Include="Microsoft.Extensions.Options" />
    <Using Include="System.Threading.RateLimiting" />
    <Using Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <Using Include="McpMySite.Core.Embeddings" />
    <Using Include="McpMySite.Server.Api" />
    <Using Include="McpMySite.Server.Mcp" />
    <Using Include="McpMySite.Server.Search" />
    <Using Include="Microsoft.AspNetCore.Cors.Infrastructure" />
    <Using Include="Microsoft.AspNetCore.HttpOverrides" />
    <Using Include="ModelContextProtocol.AspNetCore" />
    <Using Include="ModelContextProtocol.Protocol" />
    <Using Include="OpenTelemetry" />
    <Using Include="OpenTelemetry.Metrics" />
    <Using Include="OpenTelemetry.Resources" />
    <Using Include="OpenTelemetry.Trace" />
    <Using Include="McpMySite.Core.Stores" />
    <Using Include="McpMySite.Core" />
    <Using Include="McpMySite.Core.Model" />
    <Using Include="McpMySite.Core.Stores" />
    <Using Include="Microsoft.AspNetCore.Mvc" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Diagnostics.Metrics" />
    <Using Include="Microsoft.Extensions.AI" />
    <Using Include="ModelContextProtocol" />
    <Using Include="ModelContextProtocol.Server" />
    <Using Include="System.ComponentModel" />
  </ItemGroup>

</Project>
